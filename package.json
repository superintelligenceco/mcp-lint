{
  "name": "@superintelligenceco/mcp-lint",
  "version": "0.2.0",
  "description": "Lint and grade Model Context Protocol (MCP) servers: schemas, descriptions, prompt-injection surfaces, and dangerous capabilities.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lint",
    "linter",
    "security",
    "sarif",
    "cli"
  ],
  "license": "Apache-2.0",
  "author": "superintelligenceco contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superintelligenceco/mcp-lint.git"
  },
  "homepage": "https://superintelligenceco.github.io/mcp-lint/",
  "bugs": "https://github.com/superintelligenceco/mcp-lint/issues",
  "type": "module",
  "bin": {
    "mcp-lint": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome ci .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "test:coverage": "vitest run --coverage",
    "bench": "node bench/lint.bench.mjs",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ajv": "^8.20.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
